{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://jordipatuel.com,https://www.jordipatuel.com",
    "VISITOR_DAILY_LIMIT": "20",
    "GLOBAL_DAILY_LIMIT": "100"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-chatbot",
      // Production database, created with --jurisdiction eu so the data stays in the EU.
      // Not a secret: it is useless without access to the Cloudflare account.
      "database_id": "2a4f2f2e-03d9-453d-8f62-7fc14012636f",
      "migrations_dir": "migrations"
    }
  ],
  // Burst limit per network, checked at the door before any handler, D1 write or captcha call.
  // Free on every plan; approximate by design (counted per Cloudflare location).
  "ratelimits": [
    { "name": "BURST_LIMITER", "namespace_id": "1001", "simple": { "limit": 15, "period": 10 } }
  ],
  "triggers": {
    // Daily cleanup at 03:00 UTC.
    "crons": ["0 3 * * *"]
  }
}
