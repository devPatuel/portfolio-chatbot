{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://jordipatuel.com,https://www.jordipatuel.com"
  }
}
